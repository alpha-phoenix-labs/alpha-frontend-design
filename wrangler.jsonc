{
  // Cloudflare Workers mit Static Assets: liefert nur das Vite-Build-Verzeichnis aus, ohne Worker-Code.
  // Mit dieser Datei überspringt `wrangler deploy` die Auto-Konfiguration, die sonst Pakete installiert,
  // package.json-Skripte überschreibt und vite.config.ts anfasst.
  "name": "alpha-frontend-design",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Produktiv-Domain als Workers Custom Domain (Cloudflare legt DNS-Eintrag und Zertifikat selbst an).
  "routes": [
    { "pattern": "control.vantarialabs.tech", "custom_domain": true }
  ],
  // workers.dev-Adresse und Preview-URLs für PR-Vorschauen (versions upload) bleiben zusätzlich aktiv.
  "workers_dev": true,
  "preview_urls": true
}
