# Vorlage für lokale Umgebungsvariablen. Kopieren nach .env.local und nur dort Werte eintragen.
# Keine Secrets committen: Alles mit VITE_-Präfix landet im ausgelieferten Browser-Bundle.

# Factory-Modus. Leer lassen (oder "mock"): MockFactoryService. "http": Orchestrator-HTTP-API.
# Ungültige Kombinationen (http ohne gültige URL, unbekannter Modus) liefern FACTORY_CONFIG_INVALID, kein Mock-Fallback.
VITE_FACTORY_MODE=

# Basis-URL der Factory-API, nur für VITE_FACTORY_MODE=http. HTTPS (http nur für localhost),
# ohne Query, Hash oder Zugangsdaten. Endpunkte liegen unter <URL>/api/orchestrator.
VITE_FACTORY_API_BASE_URL=
